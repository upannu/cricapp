# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Supabase — NEXT_PUBLIC_* vars are safe to expose client-side (anon key is
# meant for the browser bundle); SUPABASE_SERVICE_ROLE_KEY is a secret, server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Gmail (nodemailer)
GMAIL_USER=
GMAIL_APP_PASSWORD=
PLATFORM_ADMIN_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps (geocoding)
GOOGLE_MAPS_API_KEY=

# Cron (Authorization: Bearer <CRON_SECRET> on scheduled routes)
CRON_SECRET=

# ClickSend (SMS)
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
